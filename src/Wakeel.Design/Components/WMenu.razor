@namespace Wakeel.Design.Components
@using Wakeel.Design.Text

<span class="w-menu-wrap">
    @if (TriggerContent is not null)
    {
        <button type="button" class="w-menu-trigger w-menu-trigger--custom" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" @onclick="Toggle">
            @TriggerContent
        </button>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        @* A named menu: the pill the screens' control strips carry («تصفية»), with its own icon
           and words rather than the anonymous three-dot trigger. *@
        <WTooltip Text="@(Tooltip ?? Label)">
            <button type="button" class="w-menu-trigger w-menu-trigger--pill" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" @onclick="Toggle">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <WIcon Name="@Icon" Size="16" />
                }
                <span>@Label</span>
            </button>
        </WTooltip>
    }
    else
    {
        <WTooltip Text="@Ar.Menu.MoreActions">
            <button type="button" class="w-menu-trigger" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" aria-label="@Ar.Menu.MoreActions" @onclick="Toggle">
                <WIcon Name="more-vertical" Size="18" />
            </button>
        </WTooltip>
    }
    @if (_open)
    {
        <div class="w-menu-backdrop" @onclick="Close"></div>
        <div class="w-menu-popover" role="menu">
            @foreach (var item in Items)
            {
                <button type="button" role="menuitem" class="w-menu-item @(item.Danger ? "w-menu-item--danger" : null)" @onclick="() => SelectAsync(item)">
                    <WIcon Name="@item.Icon" Size="16" />
                    <span>@item.Label</span>
                </button>
            }
        </div>
    }
</span>

@code {
    private bool _open;

    /// <summary>Ordered menu entries.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<WMenuItem> Items { get; set; } = Array.Empty<WMenuItem>();

    /// <summary>Custom trigger content (e.g. an avatar); defaults to a "more" icon button.</summary>
    [Parameter] public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Words on the trigger, which turns it into a named pill («تصفية») instead of the anonymous
    /// three-dot button. Ignored when <see cref="TriggerContent"/> is given.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Lucide icon shown before <see cref="Label"/> on the pill.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Tooltip of the pill; the label itself when none is given.</summary>
    [Parameter] public string? Tooltip { get; set; }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private async Task SelectAsync(WMenuItem item)
    {
        _open = false;
        await item.OnClick.InvokeAsync();
    }
}
