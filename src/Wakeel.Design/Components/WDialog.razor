@namespace Wakeel.Design.Components
@using Wakeel.Design.Text
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (Inline)
{
    @* The reference sheet of W92 draws the same dialogs in place, without scrim or modality, so the
       sheet and the real thing can never drift apart. *@
    <div class="w-dialog w-dialog--inline @Class" style="@WidthStyle" role="group" aria-labelledby="@_titleId">
        @Surface
    </div>
}
else if (Open)
{
    <div class="w-dialog-scrim" @onclick="HandleScrimClickAsync">
        <div class="w-dialog @Class" style="@WidthStyle" role="@(Kind == WDialogKind.Danger ? "alertdialog" : "dialog")" aria-modal="true" aria-labelledby="@_titleId" @onclick:stopPropagation="true" @ref="_dialogRef">
            @Surface
        </div>
    </div>
}

@code {
    private static int _seq;
    private readonly string _titleId = $"w-dialog-title-{Interlocked.Increment(ref _seq)}";
    private ElementReference _dialogRef;
    private DotNetObjectReference<WDialog>? _dotNetRef;
    private bool _wasOpen;

    /// <summary>Whether the dialog is currently shown.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Normal (primary confirm) or Danger (irreversible action: confirm renders as WButtonVariant.Danger).</summary>
    [Parameter] public WDialogKind Kind { get; set; } = WDialogKind.Normal;

    /// <summary>Dialog title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Explanatory paragraph under the title.</summary>
    [Parameter] public string? Desc { get; set; }

    /// <summary>Extra body content (forms, lists) below the description.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Confirm button label.</summary>
    [Parameter] public string ConfirmLabel { get; set; } = Ar.Buttons.Confirm;

    /// <summary>Cancel button label.</summary>
    [Parameter] public string CancelLabel { get; set; } = Ar.Buttons.Cancel;

    /// <summary>
    /// Confirm button icon. Defaults to a check mark, or a "no entry" glyph for the Danger kind's
    /// irreversible confirm (e.g. «حذف نهائيًا»), matching design/exports W92.
    /// </summary>
    [Parameter] public string? ConfirmIcon { get; set; }

    /// <summary>Cancel button icon. Defaults to an x mark.</summary>
    [Parameter] public string? CancelIcon { get; set; }

    /// <summary>
    /// Confirm button tooltip: what pressing it will actually do, when the label alone does not say
    /// it. Defaults to the label, so a caller that has nothing to add changes nothing.
    /// </summary>
    [Parameter] public string? ConfirmTooltip { get; set; }

    /// <summary>Cancel button tooltip; defaults to the label.</summary>
    [Parameter] public string? CancelTooltip { get; set; }

    private string ResolvedConfirmIcon => ConfirmIcon ?? (Kind == WDialogKind.Danger ? "ban" : "check");

    private string ResolvedCancelIcon => CancelIcon ?? "x";

    private string ResolvedConfirmTooltip =>
        string.IsNullOrWhiteSpace(ConfirmTooltip) ? ConfirmLabel : ConfirmTooltip;

    private string ResolvedCancelTooltip =>
        string.IsNullOrWhiteSpace(CancelTooltip) ? CancelLabel : CancelTooltip;

    /// <summary>Raised when the confirm button is clicked.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Raised when the dialog is dismissed: cancel button, close (X) button, Esc, or a click on the scrim.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>When true (default), clicking the scrim behind the dialog closes it like Cancel.</summary>
    [Parameter] public bool CloseOnScrimClick { get; set; } = true;

    /// <summary>
    /// A consequence the person must read before choosing, emphasised under the description
    /// (e.g. «إجراء نهائي لا يمكن التراجع عنه»).
    /// </summary>
    [Parameter] public string? Notice { get; set; }

    /// <summary>
    /// Draws the dialog's surface in the page instead of over it, with no scrim and no modality:
    /// the shape the reference sheet of W92 needs. <see cref="Open"/> is ignored in this mode.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Additional CSS classes on the dialog surface, so a sheet can place it on its grid.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Widest the surface may be, in pixels. A dialog that asks for two fields side by side (W94)
    /// needs more room than the 440 a one-question confirmation wants; leaving it null keeps that
    /// default.
    /// </summary>
    [Parameter] public int? MaxWidthPx { get; set; }

    private string? WidthStyle => MaxWidthPx is { } px ? $"max-width:{px}px" : null;

    /// <summary>Head, description, notice, body and actions — identical modal or inline.</summary>
    private RenderFragment Surface => @<text>
        <div class="w-dialog-head">
            <h2 id="@_titleId" class="w-dialog-title">@Title</h2>
            <button type="button" class="w-dialog-close" aria-label="@Ar.Buttons.Close" title="@Ar.Buttons.Close" @onclick="RequestCloseAsync">
                <WIcon Name="x" Size="18" />
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Desc))
        {
            <p class="w-dialog-desc">@Desc</p>
        }
        @if (!string.IsNullOrEmpty(Notice))
        {
            <p class="w-dialog-notice">@Notice</p>
        }
        @if (ChildContent is not null)
        {
            <div class="w-dialog-body">@ChildContent</div>
        }
        <div class="w-dialog-actions">
            <WButton Variant="@(Kind == WDialogKind.Danger ? WButtonVariant.Danger : WButtonVariant.Primary)"
                     Icon="@ResolvedConfirmIcon" Label="@ConfirmLabel" Tooltip="@ResolvedConfirmTooltip" OnClick="HandleConfirmAsync" />
            <WButton Variant="WButtonVariant.Secondary" Icon="@ResolvedCancelIcon" Label="@CancelLabel" Tooltip="@ResolvedCancelTooltip" OnClick="RequestCloseAsync" />
        </div>
    </text>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Inline)
        {
            // An inline surface is part of the page: it traps nothing and releases nothing.
            return;
        }

        if (Open && !_wasOpen)
        {
            _wasOpen = true;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await Js.InvokeVoidAsync("wakeelUi.trapDialog", _dialogRef, _dotNetRef);
            }
            catch (JSException)
            {
                // No interop available (e.g. a bUnit test host without the JS shim); focus trap/Esc are then inert.
            }
        }
        else if (!Open && _wasOpen)
        {
            _wasOpen = false;
            try
            {
                await Js.InvokeVoidAsync("wakeelUi.releaseDialog");
            }
            catch (JSException)
            {
                // No interop available (e.g. a bUnit test host without the JS shim).
            }
        }
    }

    /// <summary>Invoked from JS when the user presses Esc while the dialog is open.</summary>
    [JSInvokable]
    public Task HandleEscapeAsync() => RequestCloseAsync();

    private Task HandleConfirmAsync(MouseEventArgs args) => OnConfirm.InvokeAsync();

    private Task RequestCloseAsync() => OnCancel.InvokeAsync();

    private Task HandleScrimClickAsync() => CloseOnScrimClick ? RequestCloseAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef is not null)
        {
            if (_wasOpen)
            {
                try
                {
                    await Js.InvokeVoidAsync("wakeelUi.releaseDialog");
                }
                catch (JSDisconnectedException)
                {
                    // The WebView/circuit is already gone; there is nothing left to release.
                }
                catch (JSException)
                {
                    // No interop available (e.g. a bUnit test host without the JS shim).
                }
            }

            _dotNetRef.Dispose();
        }
    }
}
