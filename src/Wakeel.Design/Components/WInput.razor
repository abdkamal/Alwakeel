@namespace Wakeel.Design.Components
@using Wakeel.Design.Text
@inject IJSRuntime Js

<div class="w-field @(HasError ? "w-field--error" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="w-field-label" for="@_id">
            @Label
            @if (Required)
            {
                <span class="w-field-required" aria-hidden="true">*</span>
            }
        </label>
    }

    @if (Type == WInputType.Textarea)
    {
        <textarea id="@_id" class="w-field-control w-field-textarea" placeholder="@Placeholder" disabled="@Disabled"
                  value="@Value" @oninput="OnInputAsync" rows="4"></textarea>
    }
    else
    {
        <div class="w-field-control-wrap">
            @if (Type == WInputType.Date)
            {
                <input @ref="_dateRef" id="@_id" class="@ControlClass" type="text" inputmode="numeric" maxlength="10"
                       placeholder="@ResolvedPlaceholder" disabled="@Disabled"
                       value="@Value" @oninput="OnDateInputAsync" />
            }
            else
            {
                <input id="@_id" class="@ControlClass" type="@ResolvedHtmlType" placeholder="@ResolvedPlaceholder" disabled="@Disabled"
                       value="@Value" @oninput="OnInputAsync" />
            }
            @if (Type == WInputType.Password)
            {
                <button type="button" class="w-field-adornment" @onclick="ToggleReveal" aria-label="@(_revealed ? Ar.Fields.HidePassword : Ar.Fields.ShowPassword)" title="@(_revealed ? Ar.Fields.HidePassword : Ar.Fields.ShowPassword)">
                    <WIcon Name="@(_revealed ? "eye-off" : "eye")" Size="16" />
                </button>
            }
            else if (Type == WInputType.Date)
            {
                <span class="w-field-adornment w-field-adornment--static" aria-hidden="true">
                    <WIcon Name="calendar" Size="16" />
                </span>
            }
        </div>
    }

    @if (HasError)
    {
        <span class="w-field-hint w-field-hint--error">
            <WIcon Name="alert-circle" Size="13" />
            @Error
        </span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="w-field-hint">@Hint</span>
    }
</div>

@code {
    private static int _seq;
    private readonly string _id = $"w-field-{Interlocked.Increment(ref _seq)}";
    private bool _revealed;
    private ElementReference _dateRef;
    private int? _pendingCaret;
    private string? _pendingValue;
    private int _inputSeq;

    /// <summary>Which HTML control to render: Text, Password, Number, Date, or Textarea.</summary>
    [Parameter] public WInputType Type { get; set; } = WInputType.Text;

    /// <summary>Field label shown above the control.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Shows a required-field asterisk next to the label.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Current text value.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised on every input (use with @bind-Value).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Helper text shown under the control when there is no error.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Arabic error message. When set, replaces the hint and switches the control to its error style.</summary>
    [Parameter] public string? Error { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    /// <summary>
    /// Date and Password are the two field types with an absolutely-positioned adornment (the
    /// calendar icon / eye toggle) overlapping the control, so both need the reserved end-padding
    /// track from <c>.w-field-control--adorned</c>; every other type renders the bare control class.
    /// </summary>
    private string ControlClass
        => Type is WInputType.Date or WInputType.Password ? "w-field-control w-field-control--adorned" : "w-field-control";

    private string ResolvedHtmlType => Type switch
    {
        WInputType.Password => _revealed ? "text" : "password",
        WInputType.Number => "number",
        _ => "text",
    };

    /// <summary>
    /// ARCHITECTURE.md §12 requires dates displayed as dd/MM/yyyy with Western digits rather than the
    /// native HTML date input's locale-dependent placeholder (e.g. "yyyy-mm-dd"), so Date renders a
    /// masked text field with its own default placeholder instead of falling back to <see cref="Placeholder"/>'s absence.
    /// </summary>
    private string? ResolvedPlaceholder
        => Type == WInputType.Date && string.IsNullOrEmpty(Placeholder) ? Ar.Fields.DatePlaceholder : Placeholder;

    private void ToggleReveal() => _revealed = !_revealed;

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());

    /// <summary>
    /// Reformats free-typed input into the dd/MM/yyyy mask on every keystroke: normalizes any
    /// Arabic-indic digits to Western digits (ARCHITECTURE.md §12), drops everything else, and
    /// inserts the two separators as soon as enough digits exist for them.
    /// </summary>
    /// <remarks>
    /// The caret position that should follow the keystroke is computed from how many digits
    /// preceded the original caret (so editing the middle of an already-typed date keeps the caret
    /// next to the digit just typed instead of bouncing to the end). Both the caret and the
    /// reformatted value are stashed in <see cref="_pendingCaret"/> and <see cref="_pendingValue"/>
    /// for <see cref="OnAfterRenderAsync"/> to apply, via JS interop, once Blazor has finished
    /// re-rendering.
    /// <para>
    /// <see cref="_inputSeq"/> guards against two keystrokes racing the <c>getSelectionStart</c>
    /// round-trip out of order: if a newer keystroke's handler already resumed and stashed its own
    /// pending caret/value by the time this (older) call's await returns, this call must not
    /// overwrite that newer state with its now-stale pair.
    /// </para>
    /// <para>
    /// Whether Blazor's own diff rewrites the `value` attribute this render depends on whether
    /// <paramref name="e"/>'s reformatted text differs from the current <see cref="Value"/> — but for
    /// an unbound field (no @bind-Value/ValueChanged consumer feeding a new <see cref="Value"/> back
    /// in) that attribute never changes no matter what is typed, so branching on the comparison is
    /// unreliable. Writing <see cref="_pendingValue"/> to the DOM unconditionally after the render
    /// sidesteps that: when Blazor already wrote the same string the write is a no-op, and when it
    /// didn't (unbound field, or a rejected/mid-string keystroke) this is what corrects the DOM.
    /// </para>
    /// </remarks>
    private async Task OnDateInputAsync(ChangeEventArgs e)
    {
        var seq = ++_inputSeq;

        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = ExtractWesternDigits(raw);
        var formatted = FormatDateMask(digits);

        int caret;
        try
        {
            caret = await Js.InvokeAsync<int>("wakeelUi.getSelectionStart", _dateRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            caret = raw.Length;
        }

        if (seq != _inputSeq)
        {
            // A later keystroke already resumed and stashed its own pending caret/value; this call's
            // pair is now stale and must not overwrite that newer state or emit a stale Value.
            return;
        }

        _pendingCaret = CaretForDigitCount(formatted, CountDigitsBefore(raw, caret));
        _pendingValue = formatted;

        await ValueChanged.InvokeAsync(formatted);
    }

    /// <summary>
    /// Re-applies the value and caret computed in <see cref="OnDateInputAsync"/> after Blazor has
    /// finished diffing this render, via the value-and-caret <c>wakeelUi.setInputValue</c> helper.
    /// Doing this here, after Blazor's own render, rather than synchronously inside the input
    /// handler, is what keeps the caret where the user was typing instead of Blazor's rewrite (or the
    /// browser's own reset) bouncing it to the end of the field; writing the value here too — rather
    /// than only the caret — is what fixes an unbound field, where <see cref="Value"/> never changes
    /// and Blazor's diff therefore never touches the DOM on its own.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingCaret is not int caret)
        {
            return;
        }

        _pendingCaret = null;
        var value = _pendingValue ?? string.Empty;
        _pendingValue = null;

        try
        {
            await Js.InvokeVoidAsync("wakeelUi.setInputValue", _dateRef, value, caret);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            // No interop available (e.g. a bUnit test host without the JS shim), or the pending write
            // raced component/renderer teardown (JSDisconnectedException/ObjectDisposedException don't
            // derive from JSException); the visible DOM text/caret are a presentation nicety and do not
            // affect the emitted Value.
        }
    }

    private static int CountDigitsBefore(string raw, int caret)
    {
        var limit = Math.Min(caret, raw.Length);
        var count = 0;
        for (var i = 0; i < limit; i++)
        {
            if (raw[i] is (>= '0' and <= '9') or (>= '٠' and <= '٩'))
            {
                count++;
            }
        }

        return count;
    }

    private static int CaretForDigitCount(string formatted, int digitCount)
    {
        if (digitCount <= 0)
        {
            return 0;
        }

        var seen = 0;
        for (var i = 0; i < formatted.Length; i++)
        {
            if (formatted[i] is >= '0' and <= '9')
            {
                seen++;
                if (seen == digitCount)
                {
                    return i + 1;
                }
            }
        }

        return formatted.Length;
    }

    private static string ExtractWesternDigits(string? raw)
    {
        if (string.IsNullOrEmpty(raw))
        {
            return string.Empty;
        }

        var digits = new char[raw.Length];
        var count = 0;
        foreach (var ch in raw)
        {
            if (ch is >= '0' and <= '9')
            {
                digits[count++] = ch;
            }
            else if (ch is >= '٠' and <= '٩') // Arabic-indic digits (U+0660..U+0669)
            {
                digits[count++] = (char)('0' + (ch - '٠'));
            }
        }

        return new string(digits, 0, count);
    }

    private static string FormatDateMask(string digits)
    {
        if (digits.Length > 8)
        {
            digits = digits[..8];
        }

        return digits.Length switch
        {
            <= 2 => digits,
            <= 4 => $"{digits[..2]}/{digits[2..]}",
            _ => $"{digits[..2]}/{digits[2..4]}/{digits[4..]}",
        };
    }
}
