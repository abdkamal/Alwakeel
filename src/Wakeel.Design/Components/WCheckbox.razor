@namespace Wakeel.Design.Components

<label class="w-checkbox @(Disabled ? "w-checkbox--disabled" : null)">
    <input type="checkbox" checked="@Value" disabled="@Disabled" @onchange="OnChangeAsync" />
    <span class="w-checkbox-box" aria-hidden="true">
        @if (Value)
        {
            <WIcon Name="check" Size="13" />
        }
    </span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="w-checkbox-label">@Label</span>
    }
</label>

@code {
    /// <summary>Checked state.</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Raised when the user toggles the checkbox (use with @bind-Value).</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Arabic label shown next to the box.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e)
        => ValueChanged.InvokeAsync((bool)(e.Value ?? false));
}
