@namespace Wakeel.Design.Components

<label class="w-toggle @(Disabled ? "w-toggle--disabled" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="w-toggle-label">@Label</span>
    }
    <input type="checkbox" role="switch" aria-checked="@(Value ? "true" : "false")" checked="@Value" disabled="@Disabled" @onchange="OnChangeAsync" />
    <span class="w-toggle-track" aria-hidden="true">
        <span class="w-toggle-knob"></span>
    </span>
</label>

@code {
    /// <summary>On/off state.</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Raised when toggled (use with @bind-Value).</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Optional Arabic label shown before the switch.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e)
        => ValueChanged.InvokeAsync((bool)(e.Value ?? false));
}
