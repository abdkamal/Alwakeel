@namespace Wakeel.Design.Components
@using Wakeel.Design.Bidi

<div class="w-timeline-item">
    <span class="w-timeline-marker" aria-hidden="true"></span>
    <div class="w-timeline-body">
        <p class="w-timeline-title">@Title</p>
        @if (!string.IsNullOrEmpty(Desc))
        {
            <p class="w-timeline-desc">@Desc</p>
        }
        @if (!string.IsNullOrEmpty(Meta))
        {
            <p class="w-timeline-meta"><Bdi Text="@Meta" /></p>
        }
    </div>
</div>

@code {
    /// <summary>Event title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Explanatory line under the title.</summary>
    [Parameter] public string? Desc { get; set; }

    /// <summary>Meta line (actor and timestamp, e.g. «أحمد الخطيب · 14/09/2026 10:24»), isolated for its embedded Latin/numeric tokens.</summary>
    [Parameter] public string? Meta { get; set; }
}
