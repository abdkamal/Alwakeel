@namespace Wakeel.Design.Components
@using Wakeel.Design.Text
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="w-search">
    <WIcon Name="search" Size="16" Class="w-search-icon" />
    <input @ref="_inputRef" class="w-search-input" type="text" placeholder="@Placeholder" value="@Value" @oninput="OnInputAsync" />
    @if (ShowShortcutHint)
    {
        <Kbd Text="@Ar.LocalSearch.KbdHint" />
    }
</div>

@code {
    private ElementReference _inputRef;
    private DotNetObjectReference<WSearch>? _dotNetRef;
    private readonly string _instanceToken = Guid.NewGuid().ToString("N");

    /// <summary>Current search text.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised on every keystroke (use with @bind-Value).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Placeholder text; defaults to the standard "ابحث في هذه القائمة..." (AGREEMENT item 41).</summary>
    [Parameter] public string Placeholder { get; set; } = Ar.LocalSearch.Placeholder;

    /// <summary>Shows the "Ctrl+F" keyboard-shortcut hint chip inside the box.</summary>
    [Parameter] public bool ShowShortcutHint { get; set; } = true;

    /// <summary>
    /// When true (default), pressing Ctrl+F anywhere on the page focuses this box instead of opening
    /// the browser/WebView2 find bar. Set false on secondary search boxes on a page that already has
    /// a primary one bound to the shortcut.
    /// </summary>
    [Parameter] public bool BindGlobalShortcut { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && BindGlobalShortcut)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await Js.InvokeVoidAsync("wakeelUi.bindCtrlF", _dotNetRef, _instanceToken);
            }
            catch (JSException)
            {
                // No interop available (e.g. static prerender); the visible hint chip still documents the shortcut.
            }
        }
    }

    /// <summary>Invoked from JS when the user presses Ctrl+F while this instance is bound.</summary>
    [JSInvokable]
    public async Task FocusInputAsync() => await _inputRef.FocusAsync();

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef is not null)
        {
            try
            {
                await Js.InvokeVoidAsync("wakeelUi.unbindCtrlF", _instanceToken);
            }
            catch (JSDisconnectedException)
            {
                // The WebView/circuit is already gone; there is nothing left to unbind.
            }
            catch (JSException)
            {
                // No interop available (e.g. a bUnit test host without the JS shim).
            }

            _dotNetRef.Dispose();
        }
    }
}
