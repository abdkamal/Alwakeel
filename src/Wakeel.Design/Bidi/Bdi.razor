@namespace Wakeel.Design.Bidi

<bdi class="w-bdi">@(string.IsNullOrEmpty(Text) ? ChildContent : (RenderFragment)(builder => builder.AddContent(0, Text)))</bdi>

@code {
    /// <summary>Text to isolate. Ignored when <see cref="ChildContent"/> is supplied instead.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Markup/content to isolate; used when <see cref="Text"/> is not supplied.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
