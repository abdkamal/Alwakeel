<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!-- The organisation recovery sheet (A01) draws its code as a QR picture, and the recovery
         dialog (A02) reads one back from a picture of the printed sheet. Both versions are already
         pinned centrally in Directory.Packages.props; no new package is introduced here. -->
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wakeel.Design\Wakeel.Design.csproj" />
    <ProjectReference Include="..\Wakeel.Core\Wakeel.Core.csproj" />
    <ProjectReference Include="..\Wakeel.Crypto\Wakeel.Crypto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The admin tool carries its own schema (DATA-MODEL §13); Wakeel.Core's migration set belongs
         to a الوكيل installation and is never applied to admin.db. -->
    <EmbeddedResource Include="Migrations\*.sql" />

    <!-- The product's own Arabic typeface, carried so the provisional guide (A08) can be written as
         a readable PDF on a computer that has no such font installed. Open Font License, the same
         face the design system and the phone application ship; the licence travels beside it. -->
    <EmbeddedResource Include="Assets\NotoSansArabic-Regular.ttf" />
    <None Include="Assets\OFL-LICENSE.txt" />
  </ItemGroup>

</Project>
