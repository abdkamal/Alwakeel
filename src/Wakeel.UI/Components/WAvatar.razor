@namespace Wakeel.UI.Components

@if (!string.IsNullOrEmpty(PhotoUrl))
{
    <img class="w-avatar" style="@SizeStyle" src="@PhotoUrl" alt="@AltText" />
}
else
{
    <span class="w-avatar w-avatar--initial" style="@SizeStyle" aria-hidden="@(string.IsNullOrEmpty(AltText) ? "true" : "false")" title="@AltText">
        @Initial
    </span>
}

@code {
    /// <summary>Full name used to derive the single initial shown when no photo is available, and the alt/title text.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Optional photo URL; when set, it is rendered instead of the initial.</summary>
    [Parameter] public string? PhotoUrl { get; set; }

    /// <summary>Diameter in pixels.</summary>
    [Parameter] public int Size { get; set; } = 32;

    private string SizeStyle => FormattableString.Invariant($"width:{Size}px;height:{Size}px;font-size:{(int)Math.Round(Size * 0.42)}px;");
    private string AltText => Name ?? string.Empty;
    private string Initial => string.IsNullOrWhiteSpace(Name) ? "؟" : Name.Trim()[0].ToString();
}
