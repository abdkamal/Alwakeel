@namespace Wakeel.UI.Components
@using Wakeel.UI.Text

<span class="w-confidentiality w-confidentiality--@LevelSlug">
    <WIcon Name="@LevelIcon" Size="14" />
    <span>@LevelLabel</span>
</span>

@code {
    /// <summary>Confidentiality level (DATA-MODEL correspondence.confidentiality): Public/Private/Secret/TopSecret.</summary>
    [Parameter] public WConfidentiality Level { get; set; } = WConfidentiality.Public;

    private string LevelSlug => Level switch
    {
        WConfidentiality.Private => "private",
        WConfidentiality.Secret => "secret",
        WConfidentiality.TopSecret => "top-secret",
        _ => "public",
    };

    private string LevelIcon => Level switch
    {
        WConfidentiality.Private => "user",
        WConfidentiality.Secret => "lock",
        WConfidentiality.TopSecret => "shield",
        _ => "globe",
    };

    private string LevelLabel => Level switch
    {
        WConfidentiality.Private => Ar.Confidentiality.Private,
        WConfidentiality.Secret => Ar.Confidentiality.Secret,
        WConfidentiality.TopSecret => Ar.Confidentiality.TopSecret,
        _ => Ar.Confidentiality.Public,
    };
}
