@namespace Wakeel.UI.Components
@using Wakeel.UI.Text

<div class="w-field @(HasError ? "w-field--error" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="w-field-label" for="@_id">
            @Label
            @if (Required)
            {
                <span class="w-field-required" aria-hidden="true">*</span>
            }
        </label>
    }

    @if (Type == WInputType.Textarea)
    {
        <textarea id="@_id" class="w-field-control w-field-textarea" placeholder="@Placeholder" disabled="@Disabled"
                  value="@Value" @oninput="OnInputAsync" rows="4"></textarea>
    }
    else
    {
        <div class="w-field-control-wrap">
            <input id="@_id" class="w-field-control" type="@ResolvedHtmlType" placeholder="@Placeholder" disabled="@Disabled"
                   value="@Value" @oninput="OnInputAsync" />
            @if (Type == WInputType.Password)
            {
                <button type="button" class="w-field-adornment" @onclick="ToggleReveal" aria-label="@(_revealed ? Ar.Fields.HidePassword : Ar.Fields.ShowPassword)">
                    <WIcon Name="@(_revealed ? "eye-off" : "eye")" Size="16" />
                </button>
            }
            else if (Type == WInputType.Date)
            {
                <span class="w-field-adornment w-field-adornment--static" aria-hidden="true">
                    <WIcon Name="calendar" Size="16" />
                </span>
            }
        </div>
    }

    @if (HasError)
    {
        <span class="w-field-hint w-field-hint--error">
            <WIcon Name="alert-circle" Size="13" />
            @Error
        </span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="w-field-hint">@Hint</span>
    }
</div>

@code {
    private static int _seq;
    private readonly string _id = $"w-field-{Interlocked.Increment(ref _seq)}";
    private bool _revealed;

    /// <summary>Which HTML control to render: Text, Password, Number, Date, or Textarea.</summary>
    [Parameter] public WInputType Type { get; set; } = WInputType.Text;

    /// <summary>Field label shown above the control.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Shows a required-field asterisk next to the label.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Current text value.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised on every input (use with @bind-Value).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Helper text shown under the control when there is no error.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Arabic error message. When set, replaces the hint and switches the control to its error style.</summary>
    [Parameter] public string? Error { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string ResolvedHtmlType => Type switch
    {
        WInputType.Password => _revealed ? "text" : "password",
        WInputType.Number => "number",
        WInputType.Date => "date",
        _ => "text",
    };

    private void ToggleReveal() => _revealed = !_revealed;

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
