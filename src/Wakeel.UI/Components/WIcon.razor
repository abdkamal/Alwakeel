@namespace Wakeel.UI.Components

<svg class="w-icon @(ResolvedMirror ? "w-icon--mirror" : null) @Class"
     width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round"
     role="img" aria-hidden="@(string.IsNullOrEmpty(Title) ? "true" : "false")">
    @if (!string.IsNullOrEmpty(Title))
    {
        <title>@Title</title>
    }
    @((MarkupString)Markup)
</svg>

@code {
    /// <summary>Kebab-case Lucide icon name (e.g. "search", "check-circle"). Required.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Square size in pixels of the rendered icon. Defaults to 18 (matches 14px body text with room to breathe).</summary>
    [Parameter] public int Size { get; set; } = 18;

    /// <summary>Stroke width in the icon's own 24x24 coordinate space. Lucide's default is 2.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 2;

    /// <summary>Accessible label. When set, the icon is exposed to assistive tech; otherwise it is marked decorative (aria-hidden).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Additional CSS classes to append to the root &lt;svg&gt;.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Forces mirroring on or off. When null (default), directional icons (arrows, chevrons, sign-out,
    /// external-link) are mirrored automatically because the whole application renders right-to-left.
    /// </summary>
    [Parameter] public bool? Mirror { get; set; }

    private bool ResolvedMirror => Mirror ?? IconRegistry.DirectionalIcons.Contains(Name);

    private string Markup
    {
        get
        {
            if (IconRegistry.Icons.TryGetValue(Name, out var svg))
            {
                return svg;
            }

            // A missing icon name must never tear down the render tree in a shipped build (AGREEMENT
            // item 15: no unlocalized technical errors in the UI) — degrade to an empty glyph.
            // Debug.Fail (rather than a throw) still surfaces the mistake loudly to a developer running
            // under a debugger, without aborting an unattended bUnit test run or a production screen:
            // .NET's default trace listener only pops the assert dialog/breaks when a debugger is
            // attached, and Debug.Fail itself compiles away entirely in a non-DEBUG (Release) build.
            if (System.Diagnostics.Debugger.IsAttached)
            {
                System.Diagnostics.Debug.Fail($"Unknown icon name: '{Name}'. Add it to wwwroot/icons and regenerate IconRegistry.g.cs.");
            }

            return string.Empty;
        }
    }
}
