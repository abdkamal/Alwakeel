@namespace Wakeel.UI.Components

<div class="w-field @(HasError ? "w-field--error" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="w-field-label" for="@_id">
            @Label
            @if (Required)
            {
                <span class="w-field-required" aria-hidden="true">*</span>
            }
        </label>
    }
    <div class="w-select-wrap">
        <select id="@_id" class="w-field-control w-select-control" disabled="@Disabled" value="@Value" @onchange="OnChangeAsync">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled selected="@(string.IsNullOrEmpty(Value))">@Placeholder</option>
            }
            @foreach (var option in Options)
            {
                <option value="@option.Value" selected="@(option.Value == Value)">@option.Label</option>
            }
        </select>
        <span class="w-select-caret" aria-hidden="true">
            <WIcon Name="chevron-down" Size="16" Mirror="false" />
        </span>
    </div>
    @if (HasError)
    {
        <span class="w-field-hint w-field-hint--error">
            <WIcon Name="alert-circle" Size="13" />
            @Error
        </span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="w-field-hint">@Hint</span>
    }
</div>

@code {
    private static int _seq;
    private readonly string _id = $"w-select-{Interlocked.Increment(ref _seq)}";

    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Error { get; set; }

    /// <summary>Ordered (Value, Label) options.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Value, string Label)> Options { get; set; } = Array.Empty<(string, string)>();

    /// <summary>Selected value.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised on selection change (use with @bind-Value).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnChangeAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
