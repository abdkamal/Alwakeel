@namespace Wakeel.UI.Components

<div class="w-state-card">
    <span class="w-state-icon" aria-hidden="true">
        <WIcon Name="@Icon" Size="20" />
    </span>
    <p class="w-state-title">@Title</p>
    @if (!string.IsNullOrEmpty(Desc))
    {
        <p class="w-state-desc">@Desc</p>
    }
    @if (!string.IsNullOrEmpty(ActionLabel))
    {
        <WButton Variant="WButtonVariant.Secondary" Icon="@ActionIcon" Label="@ActionLabel" OnClick="HandleActionAsync" Class="w-state-action" />
    }
</div>

@code {
    /// <summary>Lucide icon name shown at the top of the card (e.g. "folder-open" for "no data").</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>Short Arabic title (e.g. "لا توجد بيانات بعد").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Explanatory sentence under the title.</summary>
    [Parameter] public string? Desc { get; set; }

    /// <summary>Label of the optional secondary action button (e.g. "إعادة المحاولة").</summary>
    [Parameter] public string? ActionLabel { get; set; }

    /// <summary>Icon for the action button.</summary>
    [Parameter] public string? ActionIcon { get; set; } = "refresh-cw";

    /// <summary>Raised when the action button is clicked.</summary>
    [Parameter] public EventCallback OnAction { get; set; }

    private Task HandleActionAsync(MouseEventArgs args) => OnAction.InvokeAsync();
}
