@namespace Wakeel.UI.Components

<span class="w-chip w-chip--@VariantSlug">
    @if (ShowDot)
    {
        <span class="w-chip-dot" aria-hidden="true"></span>
    }
    <span class="w-chip-label">@Label</span>
</span>

@code {
    /// <summary>Semantic color: Info/Primary/Warning/Success/Neutral/Danger.</summary>
    [Parameter] public WChipVariant Variant { get; set; } = WChipVariant.Neutral;

    /// <summary>Arabic status text shown inside the chip (e.g. "قيد المتابعة").</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Whether to show the small leading status dot (true by default, matching the status-chip pattern).</summary>
    [Parameter] public bool ShowDot { get; set; } = true;

    private string VariantSlug => Variant switch
    {
        WChipVariant.Info => "info",
        WChipVariant.Primary => "primary",
        WChipVariant.Warning => "warning",
        WChipVariant.Success => "success",
        WChipVariant.Danger => "danger",
        _ => "neutral",
    };
}
