<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-targeted (not plain net10.0): this suite launches the WPF Wakeel.Desktop.exe and is
         never meant to run on another OS. Targeting the Windows Desktop TFM also brings in
         System.Drawing.Common (via Microsoft.WindowsDesktop.App, through UseWindowsForms below)
         for W08ScreenshotDiff's PNG pixel compare, with no extra NuGet package needed beyond what
         Directory.Packages.props already pins. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Connects to the already-running WebView2 over CDP (ConnectOverCDPAsync) — no Playwright
         browser download (`playwright install`) is needed, since we never launch a bundled
         Chromium/Firefox/WebKit ourselves. The Playwright .NET driver (a small bundled Node runtime
         that the .NET API talks to) ships inside this package and is copied to the build output
         automatically; see build/e2e.ps1 for the one-time driver-install fallback if it's ever
         missing on a fresh machine. -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wakeel.Design.Text.Ar.* is the single source of truth for the Arabic strings the tests
         assert against (GalleryOpens, W08ScreenshotDiff), per ARCHITECTURE.md §12. -->
    <ProjectReference Include="..\..\src\Wakeel.Design\Wakeel.Design.csproj" />

    <!-- WalkthroughDataFolder.cs (Support) builds and activates a seeded installation on disk the
         same way the walkthrough/host-seed fixtures do, so the daily-shell screenshot tests can
         point Wakeel.Desktop.exe's data folder flag at it. Microsoft.Data.Sqlite (used to clear the
         connection pool before the host opens the same file — see that class's remarks) comes in
         transitively through Wakeel.Core's own Microsoft.EntityFrameworkCore.Sqlite.Core reference,
         so no separate package pin is needed here. -->
    <ProjectReference Include="..\..\src\Wakeel.Core\Wakeel.Core.csproj" />
    <ProjectReference Include="..\..\src\Wakeel.Crypto\Wakeel.Crypto.csproj" />
    <ProjectReference Include="..\..\src\Wakeel.UI\Wakeel.UI.csproj" />
  </ItemGroup>

</Project>
